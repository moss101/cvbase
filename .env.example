# CVBase environment template — copy to .env.cvbase.local and fill in.
# Real secrets must NEVER be committed. .env.cvbase.local is gitignored.
#
# Client-safe values (bundled into the web app at build time):
SUPABASE_URL=
SUPABASE_ANON_KEY=
STRIPE_PUBLISHABLE_KEY=

# Server-only secrets (loaded into Supabase Edge Function secrets, NEVER the bundle):
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=

# Google OAuth (configured in the Supabase dashboard, not the bundle):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
