# CVBase environment template — copy to .env.cvbase.local and fill in.
# Real secrets must NEVER be committed. .env.cvbase.local is gitignored.
#
# Client-safe values (bundled into the web app at build time):
SUPABASE_URL=
SUPABASE_ANON_KEY=
STRIPE_PUBLISHABLE_KEY=

# Server-only secrets (loaded into Supabase Edge Function secrets, NEVER the bundle):
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=

# LLM provider routing (text generation only — headshot/PDF extraction stay on
# Gemini above). Comma-separate multiple keys per provider to pool them.
# Provider/model/keys are all changeable via `supabase secrets set`, no deploy.
LLM_PRIMARY_PROVIDER=
LLM_FALLBACK_PROVIDER=
DEEPSEEK_API_KEYS=
KIMI_API_KEYS=
DEEPSEEK_MODEL_FULL=
DEEPSEEK_MODEL_LITE=
KIMI_MODEL=
# Only set these if your keys are from an aggregator, not the official
# DeepSeek/Moonshot platforms — leave blank to use the official endpoints:
DEEPSEEK_BASE_URL=
KIMI_BASE_URL=

# Google OAuth (configured in the Supabase dashboard, not the bundle):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
